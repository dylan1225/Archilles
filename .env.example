# Existing fracture analysis (optional for the building viewer).
GEMINI_API_KEY=

# Vision model for the pre-failure interior review. Every call goes through
# OpenRouter; the Gemini key above is not used for it.
OPENROUTER_API_KEY=
# Optional model override for the review: one model, or a comma-separated list
# (later models take over when an earlier one runs out of quota or credit).
# OpenRouter ids look like vendor/model.
HOUSE_ANALYSIS_MODEL=

# Matterport Model API credentials. Server only; never put in browser code.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=

# Public, domain-restricted Showcase SDK key. Tours also work without the SDK.
MATTERPORT_SDK_KEY=
MATTERPORT_SDK_DOMAINS=localhost
